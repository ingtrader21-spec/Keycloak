KEYCLOAK_VERSION=26.7.2
KEYCLOAK_IMAGE=ghcr.io/appolon1908-hue/codestra-keycloak:local

KC_HOSTNAME=https://auth.codestra.co
KC_BASE_URL=https://auth.codestra.co
KC_PUBLIC_URL=https://auth.codestra.co
KC_TARGET_REALM=codestra
KC_ADMIN_REALM=master
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_BOOTSTRAP_PASSWORD

# Secret used only to HMAC MoneyBee email-verification codes while they are
# stored in a Keycloak authentication session. Store the real value only in the
# approved runtime secret provider / protected environment; never commit it.
MONEYBEE_EMAIL_OTP_HMAC_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
