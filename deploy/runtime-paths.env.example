# Example only. Do not commit the real server values to this public repository.
# Store live values separately in protected staging and production Environments.

KC_BASE_URL=https://auth.codestra.co
KC_PUBLIC_URL=https://auth.codestra.co
KC_TARGET_REALM=codestra
KC_ADMIN_REALM=master

RUNTIME_REPO_DIR=/srv/codestra-keycloak/repository
RUNTIME_COMPOSE_FILE=/srv/codestra-keycloak/repository/compose.yaml
RUNTIME_ENV_FILE=/etc/codestra-keycloak/keycloak.env
RUNTIME_CADDY_FILE=/etc/caddy/sites-enabled/auth.codestra.co.caddy
RUNTIME_GIT_SSH_KEY=/var/lib/keycloak-deploy/.ssh/github-keycloak-readonly
RUNTIME_GIT_KNOWN_HOSTS=/var/lib/keycloak-deploy/.ssh/github-known-hosts
RUNTIME_GIT_REMOTE=git@github.com:appolon1908-hue/Keycloak.git
RUNTIME_GIT_BRANCH=main

# Set only after read-only preflight evidence has been independently reviewed.
RUNTIME_PATHS_APPROVED_SHA256=
