# Example variable contract only. Store live credentials in a protected GitHub
# Environment or the approved runtime secret provider; never commit them.

# Compose resolves this certificate hostname to 10.40.0.4 on the private VLAN.
KC_SMTP_HOST=mail.klyrow.com
KC_SMTP_PORT=587
KC_SMTP_FROM=security@codestra.co
KC_SMTP_FROM_DISPLAY_NAME=Codestra Security
KC_SMTP_REPLY_TO=support@codestra.co
KC_SMTP_ENVELOPE_FROM=bounce@codestra.co

# Secret names expected by the protected apply environment:
# KC_SMTP_USERNAME
# KC_SMTP_PASSWORD
