{
  "schemaVersion": 1,
  "kind": "CodestraCipTenantTokenMatrix",
  "mission": "CIP Foundation 3 / Agent I1 step 4",
  "description": "Offline positive/negative token matrix for the CIP tenant identity contract. Fixtures are synthetic: no token is minted and Keycloak is not contacted. Issuance fixtures model Keycloak desired-state issuance; request fixtures model the checks Kong and Middleware must apply. The same cases are exported for Kong conformance.",
  "contract": "config/desired-state/cip-tenant-identity/contract.json",
  "requiredDimensions": [
    "issuer",
    "audience",
    "azp",
    "scope",
    "tenant",
    "expiry",
    "service-account-misuse",
    "privilege-escalation"
  ],
  "additionalDimensions": [
    "project",
    "mfa",
    "algorithm"
  ],
  "statusRule": "401 when any of algorithm, issuer, audience, expiry or claims fails (the token is not authentic or not current); otherwise 403 for any authorization failure; 200 when accepted. A refused issuance has no HTTP status at the resource.",
  "mutationRule": "Dotted paths are applied to a deep copy of the fixture; missing objects are created; {\"$delete\": true} removes a key. Issuance fixtures are mutated before Keycloak issuance is simulated.",
