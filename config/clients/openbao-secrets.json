{
  "clientId": "openbao-secrets",
  "name": "Codestra OpenBao",
  "description": "Protected OpenBao browser login using Authorization Code Flow with PKCE S256.",
  "enabled": true,
  "protocol": "openid-connect",
  "clientAuthenticatorType": "client-secret",
  "publicClient": false,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "authorizationServicesEnabled": false,
  "frontchannelLogout": true,
  "fullScopeAllowed": false,
  "rootUrl": "https://bao.codestra.media",
  "baseUrl": "https://bao.codestra.media/ui/",
  "redirectUris": [
    "https://bao.codestra.media/v1/auth/oidc/callback",
    "https://bao.codestra.media/ui/vault/auth/oidc/oidc/callback",
    "http://localhost:8250/oidc/callback"
  ],
  "webOrigins": [
    "https://bao.codestra.media"
  ],
  "defaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins"
  ],
  "optionalClientScopes": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://bao.codestra.media/",
    "access.token.lifespan": "300",
    "client.session.idle.timeout": "600",
    "client.session.max.lifespan": "3600",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  }
}
