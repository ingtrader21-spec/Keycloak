{
  "clientId": "klyrow-portal",
  "name": "Klyrow Portal",
  "description": "Klyrow browser portal using Authorization Code Flow with PKCE.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "frontchannelLogout": true,
  "fullScopeAllowed": false,
  "defaultClientScopes": ["profile", "email"],
  "optionalClientScopes": [],
  "rootUrl": "https://app.klyrow.com",
  "baseUrl": "https://app.klyrow.com/",
  "redirectUris": [
    "https://app.klyrow.com/auth/callback"
  ],
  "webOrigins": [
    "https://app.klyrow.com"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://app.klyrow.com/",
    "access.token.lifespan": "300",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  },
  "protocolMappers": [{
    "name": "klyrow-api-audience",
    "protocol": "openid-connect",
    "protocolMapper": "oidc-audience-mapper",
    "consentRequired": false,
    "config": {
      "included.custom.audience": "klyrow-api",
      "access.token.claim": "true",
      "id.token.claim": "false"
    }
  }]
}
