{
  "clientId": "n8n-editor-gateway",
  "name": "Codestra n8n editor gateway",
  "description": "Confidential oauth2-proxy client protecting the community-edition n8n editor.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "authorizationServicesEnabled": false,
  "frontchannelLogout": true,
  "fullScopeAllowed": false,
  "rootUrl": "https://n8n.codestra.agency",
  "baseUrl": "https://n8n.codestra.agency/",
  "redirectUris": [
    "https://n8n.codestra.agency/oauth2/callback",
    "https://n8n-staging.codestra.agency/oauth2/callback"
  ],
  "webOrigins": [
    "https://n8n.codestra.agency",
    "https://n8n-staging.codestra.agency"
  ],
  "defaultClientScopes": [
    "profile",
    "email",
    "roles"
  ],
  "optionalClientScopes": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://n8n.codestra.agency/##https://n8n-staging.codestra.agency/",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false",
    "access.token.lifespan": "300",
    "login_theme": "codestra"
  }
}
