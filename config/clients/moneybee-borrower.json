{
  "clientId": "moneybee-borrower",
  "name": "MoneyBee Borrower Portal",
  "description": "MoneyBee borrower browser portal using Authorization Code Flow with PKCE S256.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "frontchannelLogout": true,
  "rootUrl": "https://app.moneybeeloan.com",
  "baseUrl": "https://app.moneybeeloan.com/",
  "redirectUris": [
    "https://app.moneybeeloan.com/auth/callback",
    "https://app.moneybeeloan.com/auth/silent-callback"
  ],
  "webOrigins": [
    "https://app.moneybeeloan.com"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://app.moneybeeloan.com/auth/login",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  }
}
