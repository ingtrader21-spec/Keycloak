      "kind": "product",
      "resourceServer": false,
      "audience": "social-codestra"
    },
    {
      "clientId": "transportation-backend",
      "kind": "product",
      "resourceServer": false,
      "audience": "transportation-backend"
    }
  ],
  "grants": [
