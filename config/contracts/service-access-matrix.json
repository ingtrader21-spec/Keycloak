{
  "schemaVersion": 1,
  "issuer": "https://auth.codestra.co/realms/codestra",
  "tokenEndpoint": "https://auth.codestra.co/realms/codestra/protocol/openid-connect/token",
  "jwksUri": "https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs",
  "tokenPolicy": {
    "grantType": "client_credentials",
    "maximumAccessTokenLifetimeSeconds": 300,
    "refreshTokensAllowed": false,
    "fullScopeAllowed": false,
    "secretStorage": "external-secret-store-only",
    "requiredClaims": [
      "iss",
      "sub",
      "aud",
      "azp",
      "iat",
      "exp",
      "jti",
      "scope"
    ]
  },
  "services": [
    {
      "clientId": "kong-gateway",
      "kind": "edge",
      "resourceServer": true,
      "audience": "kong-gateway",
      "baseUrlEnvironment": "KONG_GATEWAY_BASE_URL"
    },
    {
      "clientId": "middleware-api",
      "kind": "resource_server",
      "resourceServer": true,
      "audience": "middleware-api",
      "baseUrlEnvironment": "MIDDLEWARE_API_BASE_URL"
    },
    {
      "clientId": "middleware-worker",
      "kind": "workload",
      "resourceServer": false,
      "audience": "middleware-worker"
    },
    {
      "clientId": "odoo-integration",
      "kind": "adapter",
      "resourceServer": true,
      "audience": "odoo-integration",
      "baseUrlEnvironment": "ODOO_INTEGRATION_BASE_URL"
    },
    {
      "clientId": "n8n-automation",
      "kind": "automation",
      "resourceServer": true,
      "audience": "n8n-automation",
      "baseUrlEnvironment": "N8N_AUTOMATION_BASE_URL"
    },
    {
      "clientId": "vicidial-adapter",
      "kind": "adapter",
      "resourceServer": true,
      "audience": "vicidial-adapter",
      "baseUrlEnvironment": "VICIDIAL_ADAPTER_BASE_URL"
    },
    {
      "clientId": "telnexa-gateway",
      "kind": "provider_gateway",
      "resourceServer": true,
      "audience": "telnexa-gateway",
      "baseUrlEnvironment": "TELNEXA_GATEWAY_BASE_URL"
    },
    {
      "clientId": "klyrow-gateway",
      "kind": "provider_gateway",
      "resourceServer": true,
      "audience": "klyrow-gateway",
      "baseUrlEnvironment": "KLYROW_GATEWAY_BASE_URL"
    },
    {
      "clientId": "klyrow-saas",
      "kind": "product",
      "resourceServer": false,
      "audience": "klyrow-saas"
    },
    {
      "clientId": "kyqra-gateway",
      "kind": "provider_gateway",
      "resourceServer": true,
      "audience": "kyqra-gateway",
      "baseUrlEnvironment": "KYQRA_GATEWAY_BASE_URL"
    },
    {
      "clientId": "kyqra-saas",
      "kind": "product",
      "resourceServer": false,
      "audience": "kyqra-saas"
    },
    {
      "clientId": "postly-adapter",
      "kind": "adapter",
      "resourceServer": true,
      "audience": "postly-adapter",
      "baseUrlEnvironment": "POSTLY_ADAPTER_BASE_URL"
    },
    {
      "clientId": "provisioning-service",
      "kind": "workload",
      "resourceServer": false,
      "audience": "provisioning-service"
    },
    {
      "clientId": "monitoring-readonly",
      "kind": "monitoring",
      "resourceServer": false,
      "audience": "monitoring-readonly"
    },
    {
      "clientId": "beyvra-backend",
      "kind": "product",
      "resourceServer": false,
      "audience": "beyvra-backend"
    },
    {
      "clientId": "breero-backend",
      "kind": "product",
      "resourceServer": false,
      "audience": "breero-backend"
    },
    {
      "clientId": "larim-a-backend",
      "kind": "product",
      "resourceServer": false,
