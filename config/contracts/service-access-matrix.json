{
  "schemaVersion": 1,
  "issuer": "https://auth.codestra.co/realms/codestra",
  "tokenEndpoint": "https://auth.codestra.co/realms/codestra/protocol/openid-connect/token",
  "jwksUri": "https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs",
  "tokenPolicy": {
    "grantType": "client_credentials",
    "maximumAccessTokenLifetimeSeconds": 300,
    "refreshTokensAllowed": false,
    "fullScopeAllowed": false,
    "secretStorage": "external-secret-store-only",
    "requiredClaims": ["iss", "sub", "aud", "azp", "iat", "exp", "jti", "scope"]
  },
  "services": [
    {"clientId": "kong-gateway", "kind": "edge", "resourceServer": true, "audience": "kong-gateway", "baseUrlEnvironment": "KONG_GATEWAY_BASE_URL"},
    {"clientId": "middleware-api", "kind": "resource_server", "resourceServer": true, "audience": "middleware-api", "baseUrlEnvironment": "MIDDLEWARE_API_BASE_URL"},
    {"clientId": "middleware-worker", "kind": "workload", "resourceServer": false, "audience": "middleware-worker"},
    {"clientId": "codestra-ai", "kind": "application", "resourceServer": false, "audience": "codestra-ai"},
    {"clientId": "codestra-communication", "kind": "application", "resourceServer": false, "audience": "codestra-communication"},
    {"clientId": "codestra-marketing", "kind": "application", "resourceServer": false, "audience": "codestra-marketing"},
    {"clientId": "codestra-social", "kind": "application", "resourceServer": false, "audience": "codestra-social"},
    {"clientId": "ai-provider-adapter", "kind": "adapter", "resourceServer": true, "audience": "ai-provider-adapter", "baseUrlEnvironment": "AI_PROVIDER_ADAPTER_BASE_URL"},
    {"clientId": "marketing-provider-adapter", "kind": "adapter", "resourceServer": true, "audience": "marketing-provider-adapter", "baseUrlEnvironment": "MARKETING_PROVIDER_ADAPTER_BASE_URL"},
    {"clientId": "odoo-integration", "kind": "adapter", "resourceServer": true, "audience": "odoo-integration", "baseUrlEnvironment": "ODOO_INTEGRATION_BASE_URL"},
    {"clientId": "n8n-automation", "kind": "automation", "resourceServer": true, "audience": "n8n-automation", "baseUrlEnvironment": "N8N_AUTOMATION_BASE_URL"},
    {"clientId": "vicidial-adapter", "kind": "adapter", "resourceServer": true, "audience": "vicidial-adapter", "baseUrlEnvironment": "VICIDIAL_ADAPTER_BASE_URL"},
    {"clientId": "telnexa-gateway", "kind": "provider_gateway", "resourceServer": true, "audience": "telnexa-gateway", "baseUrlEnvironment": "TELNEXA_GATEWAY_BASE_URL"},
    {"clientId": "klyrow-gateway", "kind": "provider_gateway", "resourceServer": true, "audience": "klyrow-gateway", "baseUrlEnvironment": "KLYROW_GATEWAY_BASE_URL"},
    {"clientId": "kyqra-gateway", "kind": "provider_gateway", "resourceServer": true, "audience": "kyqra-gateway", "baseUrlEnvironment": "KYQRA_GATEWAY_BASE_URL"},
    {"clientId": "postly-adapter", "kind": "adapter", "resourceServer": true, "audience": "postly-adapter", "baseUrlEnvironment": "POSTLY_ADAPTER_BASE_URL"},
    {"clientId": "provisioning-service", "kind": "workload", "resourceServer": false, "audience": "provisioning-service"},
    {"clientId": "monitoring-readonly", "kind": "monitoring", "resourceServer": false, "audience": "monitoring-readonly"}
  ],
  "grants": [
    {"callerClientId": "kong-gateway", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["middleware.request.forward", "middleware.status.read"]},
    {"callerClientId": "middleware-worker", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["delivery.retry", "dlq.replay", "inbox.process", "outbox.dispatch"]},
    {"callerClientId": "codestra-ai", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["ai.inference.request"]},
    {"callerClientId": "codestra-communication", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["communication.email.request", "communication.sms.request"]},
    {"callerClientId": "codestra-marketing", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["marketing.campaign.request"]},
    {"callerClientId": "codestra-social", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["social.publish.request"]},
    {"callerClientId": "odoo-integration", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["odoo.delivery.result.publish", "odoo.events.publish"]},
    {"callerClientId": "middleware-api", "targetClientId": "odoo-integration", "audience": "odoo-integration", "scopes": ["odoo.activities.write", "odoo.leads.read", "odoo.leads.write"]},
    {"callerClientId": "middleware-api", "targetClientId": "n8n-automation", "audience": "n8n-automation", "scopes": ["workflow.status.read", "workflow.trigger"]},
    {"callerClientId": "n8n-automation", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["automation.command.request", "workflow.result.publish"]},
    {"callerClientId": "vicidial-adapter", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["callbacks.update", "recordings.metadata.publish", "telephony.events.publish"]},
    {"callerClientId": "middleware-api", "targetClientId": "vicidial-adapter", "audience": "vicidial-adapter", "scopes": ["callbacks.dispatch", "telephony.commands.write"]},
    {"callerClientId": "middleware-worker", "targetClientId": "telnexa-gateway", "audience": "telnexa-gateway", "scopes": ["sms.send", "sms.status.read"]},
    {"callerClientId": "telnexa-gateway", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["sms.events.publish", "sms.inbound.publish"]},
    {"callerClientId": "middleware-worker", "targetClientId": "klyrow-gateway", "audience": "klyrow-gateway", "scopes": ["email.send", "email.status.read"]},
    {"callerClientId": "klyrow-gateway", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["email.events.publish", "email.inbound.publish"]},
    {"callerClientId": "middleware-api", "targetClientId": "kyqra-gateway", "audience": "kyqra-gateway", "scopes": ["crawler.jobs.read", "crawler.jobs.submit", "crawler.results.read"]},
    {"callerClientId": "kyqra-gateway", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["crawler.progress.publish", "crawler.results.publish"]},
    {"callerClientId": "middleware-worker", "targetClientId": "postly-adapter", "audience": "postly-adapter", "scopes": ["social.publish"]},
    {"callerClientId": "middleware-worker", "targetClientId": "ai-provider-adapter", "audience": "ai-provider-adapter", "scopes": ["ai.provider.dispatch"]},
    {"callerClientId": "middleware-worker", "targetClientId": "marketing-provider-adapter", "audience": "marketing-provider-adapter", "scopes": ["marketing.provider.dispatch"]},
    {"callerClientId": "postly-adapter", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["social.events.publish"]},
    {"callerClientId": "provisioning-service", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["identity.request", "integration.configure", "tenant.provision"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "kong-gateway", "audience": "kong-gateway", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "middleware-api", "audience": "middleware-api", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "odoo-integration", "audience": "odoo-integration", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "n8n-automation", "audience": "n8n-automation", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "vicidial-adapter", "audience": "vicidial-adapter", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "telnexa-gateway", "audience": "telnexa-gateway", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "klyrow-gateway", "audience": "klyrow-gateway", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "kyqra-gateway", "audience": "kyqra-gateway", "scopes": ["health.read", "metrics.read"]},
    {"callerClientId": "monitoring-readonly", "targetClientId": "postly-adapter", "audience": "postly-adapter", "scopes": ["health.read", "metrics.read"]}
  ],
  "prohibitedDirectTargets": {
    "n8n-automation": ["odoo-integration", "vicidial-adapter", "telnexa-gateway", "klyrow-gateway", "kyqra-gateway", "postly-adapter", "ai-provider-adapter", "marketing-provider-adapter"]
  },
  "administrativeBoundaries": {
    "provisioning-service": {
      "keycloakAdminApiAccess": false,
      "prohibitedRealmManagementRoles": ["realm-admin", "manage-realm", "manage-clients"]
    }
  }
}
