{
  "clientId": "test-syn-n8n-submit",
  "name": "Codestra edge-certification identity: test-syn-n8n-submit",
  "description": "Isolated staging service identity for the TEST_SYN Keycloak -> Caddy -> Kong -> Middleware edge certification. Submits one safe TEST_SYN n8n result through the shared edge; expected 202. Repository-only desired state outside the protected managed-client policy; never a production client.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": false,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": true,
  "authorizationServicesEnabled": false,
  "frontchannelLogout": false,
  "fullScopeAllowed": false,
  "redirectUris": [],
  "webOrigins": [],
  "defaultClientScopes": [
    "basic",
    "n8n.results.submit"
  ],
  "optionalClientScopes": [],
  "attributes": {
    "access.token.lifespan": "300",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  },
  "protocolMappers": [
    {
      "name": "audience-middleware-api",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "middleware-api",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    },
    {
      "name": "claim-environment",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "environment",
        "claim.value": "staging",
        "jsonType.label": "String",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "claim-tenant-id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "tenant_id",
        "claim.value": "TEST_SYN_TENANT",
        "jsonType.label": "String",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "claim-business-units",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "business_units",
        "claim.value": "[\"TEST_SYN\"]",
        "jsonType.label": "JSON",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "claim-campaigns",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "campaigns",
        "claim.value": "[\"TEST_SYN\"]",
        "jsonType.label": "JSON",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    }
  ]
}
