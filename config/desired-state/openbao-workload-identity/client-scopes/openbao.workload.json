{
  "name": "openbao.workload",
  "description": "Codestra optional workload scope managed by repository desired state. Requested explicitly per short-lived service-account token when a workload authenticates to OpenBao; it adds the openbao audience and the codestra_environment claim OpenBao roles require. Never a realm default scope.",
  "protocol": "openid-connect",
  "attributes": {
    "display.on.consent.screen": "false",
    "include.in.token.scope": "true"
  },
  "protocolMappers": [
    {
      "name": "audience-openbao",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "openbao",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    },
    {
      "name": "claim-codestra-environment",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "codestra_environment",
        "claim.value": "${CODESTRA_ENVIRONMENT}",
        "jsonType.label": "String",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    }
  ]
}
