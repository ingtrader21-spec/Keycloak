{"info":{"name":"Keycloak Control API - Fail Closed","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"baseUrl","value":"http://127.0.0.1:8785"}],"item":[
{"name":"Health","request":{"method":"GET","header":[{"key":"X-Correlation-ID","value":"postman-health"}],"url":{"raw":"{{baseUrl}}/platform/v1/keycloak/health","host":["{{baseUrl}}"],"path":["platform","v1","keycloak","health"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('apply disabled',()=>pm.expect(pm.response.json().applyEnabled).to.eql(false));","pm.test('correlation',()=>pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql('postman-health'));"]}}]},
{"name":"Desired State","request":{"method":"GET","url":{"raw":"{{baseUrl}}/platform/v1/keycloak/desired-state","host":["{{baseUrl}}"],"path":["platform","v1","keycloak","desired-state"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('authority schema',()=>pm.expect(pm.response.json().desired.schema).to.eql('codestra.keycloak.identity-authority.v1'));"]}}]},
{"name":"Validate","request":{"method":"POST","url":{"raw":"{{baseUrl}}/platform/v1/keycloak/validate","host":["{{baseUrl}}"],"path":["platform","v1","keycloak","validate"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('valid',()=>pm.expect(pm.response.json().valid).to.eql(true));"]}}]},
{"name":"Apply Fail Closed","request":{"method":"POST","header":[{"key":"X-Idempotency-Key","value":"postman-no-mutate"}],"url":{"raw":"{{baseUrl}}/platform/v1/keycloak/reconcile/apply","host":["{{baseUrl}}"],"path":["platform","v1","keycloak","reconcile","apply"]}},"event":[{"listen":"test","script":{"exec":["pm.test('403',()=>pm.response.to.have.status(403));","pm.test('disabled',()=>pm.expect(pm.response.json().error.code).to.eql('apply_disabled'));"]}}]},
{"name":"Recovery Status","request":{"method":"GET","url":{"raw":"{{baseUrl}}/platform/v1/keycloak/recovery/status","host":["{{baseUrl}}"],"path":["platform","v1","keycloak","recovery","status"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('state bounded',()=>pm.expect(['HEALTHY','STALE','INVALID','UNKNOWN']).to.include(pm.response.json().recovery.state));"]}}]},
{"name":"Promotion Policy","request":{"method":"GET","url":{"raw":"{{baseUrl}}/platform/v1/keycloak/promotion/policy","host":["{{baseUrl}}"],"path":["platform","v1","keycloak","promotion","policy"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('TEST_SYN blocked',()=>pm.expect(pm.response.json().policy.testSynProductionBlocked).to.eql(true));"]}}]}
